{
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=ConferenceBooking;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Pricing": {
    "OpensAt": "06:00",
    "ClosesAt": "23:00",
