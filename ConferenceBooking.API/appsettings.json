    "RateWindows": [
      {
        "Name": "Ранкові години",
        "Start": "06:00",
        "End": "09:00",
        "Multiplier": 0.90,
        "Priority": 1
      },
      {
        "Name": "Стандартні години",
        "Start": "09:00",
        "End": "18:00",
        "Multiplier": 1.00,
        "Priority": 1
      },
      {
        "Name": "Пікові години",
        "Start": "12:00",
        "End": "14:00",
        "Multiplier": 1.15,
        "Priority": 2
      },
      {
        "Name": "Вечірні години",
        "Start": "18:00",
        "End": "23:00",
        "Multiplier": 0.80,
        "Priority": 1
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
